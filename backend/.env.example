# Alkame Backend Environment Variables Example

# LLM Configuration (Groq / Llama 3.3 70B / OpenAI / Ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (Optional fallback)
OPENAI_API_KEY=

# Database
DATABASE_URL=postgresql://alkame_user:alkame_password@localhost:5432/alkame_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:3000

# Security
SECRET_KEY=alkame-dev-secret-key-change-in-production
DEBUG=true
